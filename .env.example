# AutoHub Premium Car Marketplace - Environment Variables Template
# Copy this file to .env.local for local overrides. Do NOT commit secret keys.

# Optional: Host URL for self-referential links, meta tags, and preview links
VITE_APP_URL="https://autohub-marketplace.vercel.app"

# Optional: Application Brand Name
VITE_MARKETPLACE_NAME="AutoHub"

# Server-side / Runtime secrets (Injected automatically by cloud environment when needed)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
